---
import type { CollectionEntry } from 'astro:content';
import { tagSlug } from '../lib/tags';

interface Props {
  post: CollectionEntry<'posts'>;
  order?: number;
  headingLevel?: 2 | 3;
}

const { post, order, headingLevel = 2 } = Astro.props;
const Heading = `h${headingLevel}`;
const date = post.data.published.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: '2-digit',
});
---

<article class="post-card">
  <div class="post-meta">
    {order && <span class="post-order">{String(order).padStart(2, '0')}</span>}
    <time datetime={post.data.published.toISOString()}>{date}</time>
  </div>
  <div>
    <Heading><a href={`/posts/${post.id}/`}>{post.data.title}</a></Heading>
    <p>{post.data.description}</p>
    <ul class="tag-list" aria-label="Tags">
      {post.data.tags.map((tag) => <li><a href={`/tags/${tagSlug(tag)}/`}>{tag}</a></li>)}
    </ul>
  </div>
  <a class="arrow-link" href={`/posts/${post.id}/`} aria-label={`Read ${post.data.title}`}>↗</a>
</article>
