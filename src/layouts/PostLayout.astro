---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import { tagSlug } from '../lib/tags';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
const date = post.data.published.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  published={post.data.published}
  updated={post.data.updated}
  tags={post.data.tags}
>
  <article class="article-layout">
    <aside class="article-rail" aria-label="Article details">
      <span class="rail-dot"></span>
      <time datetime={post.data.published.toISOString()}>{date}</time>
      {post.data.tags.length > 0 && (
        <ul class="rail-tags" aria-label="Tags">
          {post.data.tags.map((tag) => <li><a href={`/tags/${tagSlug(tag)}/`}>{tag}</a></li>)}
        </ul>
      )}
    </aside>
    <div class="article-main">
      <header class="article-header">
        <a class="back-link" href="/posts/">← All writing</a>
        <h1>{post.data.title}</h1>
        <p>{post.data.description}</p>
      </header>
      <div class="prose">
        <Content />
      </div>
      <footer class="article-end">
        <span>End of note</span>
        <a href="/posts/">Continue reading →</a>
      </footer>
    </div>
  </article>
</BaseLayout>
