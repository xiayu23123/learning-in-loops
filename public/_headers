# Cloudflare Pages response headers.
# Hashed build assets never change, so they can be cached for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Keep preview deployments (<hash>.learning-in-loops.pages.dev and
# <branch>.learning-in-loops.pages.dev) out of search results.
https://:hash.learning-in-loops.pages.dev/*
  X-Robots-Tag: noindex
